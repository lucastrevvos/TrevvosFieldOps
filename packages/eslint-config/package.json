{
  "name": "@trevvos-fieldops/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "build": "node -e \"import('./index.mjs')\"",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint --config index.mjs . && prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node -e \"import('./index.mjs')\""
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
