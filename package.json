{
  "name": "trevvos-fieldops",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed field operations platform built with NestJS, React, messaging and GCP.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf .turbo",
    "db:migrate": "pnpm --filter @trevvos-fieldops/api db:migrate",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d --wait",
    "lint": "turbo run lint && prettier --check .",
    "messaging:worker": "pnpm --filter @trevvos-fieldops/api messaging:worker",
    "test": "turbo run test:unit",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
