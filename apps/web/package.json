{
  "name": "@trevvos-fieldops/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --passWithNoTests src/**/*.integration.test.tsx",
    "test:unit": "vitest run --exclude src/**/*.integration.test.tsx",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@trevvos-fieldops/eslint-config": "workspace:*",
    "@trevvos-fieldops/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
